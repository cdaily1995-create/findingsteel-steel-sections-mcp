{
  "name": "findingsteel-steel-sections-mcp",
  "version": "0.1.1",
  "description": "MCP server for Chinese (GB) standard steel sections: look up section properties (A, Ix, Iy, Wx, Wy, ix, iy) and calculate theoretical weight for H-beams, I-beams, channels, angles, C/Z purlins, square/rectangular hollow sections and welded sections.",
  "type": "module",
  "license": "MIT",
  "author": "FindingSteel (Jiangxin Steel Structure)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdaily1995-create/findingsteel-steel-sections-mcp.git"
  },
  "homepage": "https://www.findingsteel.com/en/",
  "bugs": {
    "url": "https://github.com/cdaily1995-create/findingsteel-steel-sections-mcp/issues"
  },
  "keywords": [
    "steel-sections",
    "gb-standard",
    "structural-steel",
    "steel-weight-calculator",
    "section-properties",
    "mcp",
    "steel-fabrication"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "findingsteel-steel-sections": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@modelcontextprotocol/sdk",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "node src/index.ts",
    "start": "node src/index.ts",
    "serve": "node src/serve.ts",
    "test": "node test/smoke.mjs && node test/e2e_stdio.mjs && node test/e2e_http.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.8.3"
  }
}
